@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
@inject TruckMate.Services.BrandingService Branding
@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var action = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
    var token = Antiforgery.GetAndStoreTokens(ViewContext.HttpContext).RequestToken;
    var logoUrl = Branding.GetLogoRelativeUrl();
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(ViewData["Title"]?.ToString() ?? "Dashboard") · TruckMate Weighbridge</title>
    <script>
        (function () {
            try {
                var t = localStorage.getItem("tmTheme");
                if (!t) t = window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
                document.documentElement.setAttribute("data-bs-theme", t);
            } catch (e) {
                document.documentElement.setAttribute("data-bs-theme", "light");
            }
        })();
    </script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/truckmate.css" asp-append-version="true" />
</head>
<body>
    <input id="antiforgery-token" type="hidden" value="@token" />

    <aside class="tm-sidebar" id="tmSidebar">
        <a class="tm-brand" asp-controller="Home" asp-action="Index">
            @if (logoUrl is not null)
            {
                <img src="@logoUrl" alt="Company logo" class="tm-brand-logo" />
            }
            TruckMate
            <small>Weighbridge Management System</small>
        </a>

        @if (User.Identity?.IsAuthenticated == true)
        {
            <nav class="tm-nav">
                @if (User.IsInRole("Operator"))
                {
                    <div class="tm-nav-label">Operator</div>
                    <a class="nav-link @(controller == "Operator" && action == "Index" ? "active" : "")" asp-controller="Operator" asp-action="Index">Operation</a>
                    <a class="nav-link @(controller == "Operator" && action == "Transactions" ? "active" : "")" asp-controller="Operator" asp-action="Transactions">Transactions</a>
                    <a class="nav-link @(controller == "Operator" && action == "Reprint" ? "active" : "")" asp-controller="Operator" asp-action="Reprint">Re-Print</a>
                    <a class="nav-link @(controller == "Reports" ? "active" : "")" asp-controller="Reports" asp-action="Index">Reports</a>
                    <a class="nav-link @(controller == "Operator" && action == "PdfLog" ? "active" : "")" asp-controller="Operator" asp-action="PdfLog">PDF</a>
                }
                @if (User.IsInRole("Admin"))
                {
                    <div class="tm-nav-label">Administration</div>
                    <a class="nav-link @(controller == "Admin" && action == "Index" ? "active" : "")" asp-controller="Admin" asp-action="Index">Dashboard</a>
                    <a class="nav-link @(controller == "Admin" && action == "Records" ? "active" : "")" asp-controller="Admin" asp-action="Records">Records</a>
                    <a class="nav-link @(controller == "Admin" && action == "MasterData" ? "active" : "")" asp-controller="Admin" asp-action="MasterData">Master data</a>
                    <a class="nav-link @(controller == "Admin" && action == "Expired" ? "active" : "")" asp-controller="Admin" asp-action="Expired">Expired</a>
                    <a class="nav-link @(controller == "Reports" ? "active" : "")" asp-controller="Reports" asp-action="Index">Reports</a>
                }
                @if (User.IsInRole("SuperAdmin"))
                {
                    <div class="tm-nav-label">Super Admin</div>
                    <a class="nav-link @(controller == "SuperAdmin" && action == "Index" ? "active" : "")" asp-controller="SuperAdmin" asp-action="Index">Users</a>
                    <a class="nav-link @(controller == "SuperAdmin" && action == "Settings" ? "active" : "")" asp-controller="SuperAdmin" asp-action="Settings">Settings</a>
                    <a class="nav-link @(controller == "SuperAdmin" && action == "Audit" ? "active" : "")" asp-controller="SuperAdmin" asp-action="Audit">Audit log</a>
                }
            </nav>

            <div class="tm-sidebar-foot">
                @if (User.IsInRole("Operator"))
                {
                    <div data-scale-widget class="tm-scale-widget">-- kg</div>
                }
                <div class="tm-user">
                    @User.DisplayName()
                    <span class="role">@User.RoleName()</span>
                </div>
                <form asp-controller="Account" asp-action="Logout" method="post">
                    <button type="submit" class="btn btn-sm btn-outline-light w-100" title="Logout">Logout</button>
                </form>
            </div>
        }
    </aside>

    <div class="tm-backdrop" id="tmBackdrop"></div>

    <div class="tm-main">
        <header class="tm-topstrip">
            <button class="tm-burger" id="tmBurger" type="button" aria-label="Toggle navigation" title="Hide / show navigation">
                <span></span><span></span><span></span>
            </button>
            <span class="tm-topstrip-title">TruckMate</span>

            <button class="tm-theme-toggle" id="tmTheme" type="button" aria-label="Toggle dark mode" title="Dark / light mode">
                <svg class="icon-moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z" />
                </svg>
                <svg class="icon-sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <circle cx="12" cy="12" r="4" />
                    <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
                </svg>
            </button>
        </header>

        <main class="tm-content">
            @if (TempData["Success"] is not null)
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    @TempData["Success"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }
            @if (TempData["Error"] is not null)
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    @TempData["Error"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }
            @if (TempData["Info"] is not null)
            {
                <div class="alert alert-info alert-dismissible fade show" role="alert">
                    @TempData["Info"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }
            @RenderBody()
        </main>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/truckmate.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
