@model List<TruckMate.Domain.Ticket>
@{
    ViewData["Title"] = "PDF";
    var folder = ViewBag.Folder as string;
    var type = ViewBag.Type as string ?? "All";
}

<div class="page-title">PDF</div>
<div class="page-sub mb-3">Ticket and report PDFs saved on this computer.</div>

<div class="card mb-3">
    <div class="card-body d-flex flex-wrap gap-3 align-items-center">
        <div>
            <div class="text-muted" style="font-size:12px;">Save folder on this computer</div>
            <code>@folder</code>
        </div>
        <div class="ms-auto">
            <a class="btn btn-outline-secondary btn-sm" href="https://learn.microsoft.com/en-us/windows/explorer/" target="_blank" rel="noopener">Open system folder</a>
        </div>
    </div>
</div>

<div class="card">
    <div class="card-header">
        <ul class="nav nav-pills">
            <li class="nav-item"><a class="nav-link @(type == "All" ? "active" : "")" style="@(type == "All" ? "background:#0ea5e9;" : "")" asp-action="PdfLog" asp-route-type="All">All</a></li>
            <li class="nav-item"><a class="nav-link @(type == "Tickets" ? "active" : "")" style="@(type == "Tickets" ? "background:#0ea5e9;" : "")" asp-action="PdfLog" asp-route-type="Tickets">Tickets</a></li>
            <li class="nav-item"><a class="nav-link" asp-action="PdfLog" asp-route-type="Reports">Reports</a></li>
        </ul>
    </div>
    <div class="table-responsive">
        <table class="table-tm">
            <thead>
                <tr>
                    <th>File</th>
                    <th>Type</th>
                    <th>Reference</th>
                    <th>Saved at</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var t in Model)
                {
                    <tr>
                        <td class="mono">@(t.PdfPath is null ? "" : System.IO.Path.GetFileName(t.PdfPath))</td>
                        <td>Ticket @(t.IsReprint ? "(duplicate)" : "")</td>
                        <td class="mono">@t.Transaction?.TicketNo</td>
                        <td class="mono">@t.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                        <td>
                            <a class="btn btn-sm btn-outline-primary" asp-action="TicketPdfFile" asp-route-id="@t.TicketId" target="_blank">Open · Print</a>
                        </td>
                    </tr>
                }
                @if (Model.Count == 0)
                {
                    <tr><td colspan="5" class="empty">No saved PDFs yet. Save a ticket as PDF to see it here.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>