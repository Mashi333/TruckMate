@{
    ViewData["Title"] = "Master data";
    var tab = ViewBag.Tab as string ?? "suppliers";
    string[] tabs = { "suppliers", "materials", "transporters", "drivers" };
    var suppliers = ViewBag.Suppliers as List<MasterItem> ?? new();
    var materials = ViewBag.Materials as List<Material> ?? new();
    var transporters = ViewBag.Transporters as List<MasterItem> ?? new();
    var drivers = ViewBag.Drivers as List<MasterItem> ?? new();
    string tabName(string t) => t switch { "materials" => "Materials", "transporters" => "Transporters", "drivers" => "Drivers", _ => "Suppliers" };
}

<div class="page-title">Master data</div>
<div class="page-sub mb-3">Lists operators choose from.</div>

<div class="card">
    <div class="card-header">
        <ul class="nav nav-pills">
            @foreach (var t in tabs)
            {
                <li class="nav-item">
                    <a class="nav-link @(tab == t ? "active" : "")" style="@(tab == t ? "background:#0ea5e9;" : "")" asp-action="MasterData" asp-route-tab="@t">@tabName(t)</a>
                </li>
            }
        </ul>
    </div>
    <div class="card-body">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h6 class="mb-0">@tabName(tab)</h6>
            <button class="btn btn-sm btn-primary" style="background:#0ea5e9;border-color:#0ea5e9;" data-bs-toggle="collapse" data-bs-target="#addForm">Add @tabName(tab).TrimEnd('s')</button>
        </div>

        <div class="collapse mb-3" id="addForm">
            <form asp-action="AddMasterItem" method="post" class="row g-2">
                <input type="hidden" name="tab" value="@tab" />
                <div class="col-auto">
                    <input class="form-control form-control-sm" name="name" placeholder="Name" required />
                </div>
                <div class="col-auto">
                    <button class="btn btn-sm btn-success">SAVE</button>
                </div>
            </form>
        </div>

        <table class="table-tm">
            <thead>
                <tr><th>NAME</th><th>STATUS</th><th>ACTION</th></tr>
            </thead>
            <tbody>
                @if (tab == "materials")
                {
                    @foreach (var m in materials)
                    {
                        <tr>
                            <td>@m.Name</td>
                            <td><span class="badge @(m.IsActive ? "badge-completed" : "badge-cancelled")">@(m.IsActive ? "Active" : "Inactive")</span></td>
                            <td>
                                <form asp-action="ToggleMasterItem" method="post" class="d-inline">
                                    <input type="hidden" name="tab" value="@tab" />
                                    <input type="hidden" name="id" value="@m.MaterialId" />
                                    <button class="btn btn-sm btn-outline-secondary">@(m.IsActive ? "Deactivate" : "Activate")</button>
                                </form>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    var items = tab switch { "transporters" => transporters, "drivers" => drivers, _ => suppliers };
                    @foreach (var i in items)
                    {
                        <tr>
                            <td>@i.Name</td>
                            <td><span class="badge @(i.IsActive ? "badge-completed" : "badge-cancelled")">@(i.IsActive ? "Active" : "Inactive")</span></td>
                            <td>
                                <form asp-action="ToggleMasterItem" method="post" class="d-inline">
                                    <input type="hidden" name="tab" value="@tab" />
                                    <input type="hidden" name="id" value="@i.MasterItemId" />
                                    <button class="btn btn-sm btn-outline-secondary">@(i.IsActive ? "Deactivate" : "Activate")</button>
                                </form>
                            </td>
                        </tr>
                    }
                }
                @if ((tab == "materials" && materials.Count == 0) || (tab != "materials" && ((tab == "suppliers" && suppliers.Count == 0) || (tab == "transporters" && transporters.Count == 0) || (tab == "drivers" && drivers.Count == 0))))
                {
                    <tr><td colspan="3" class="empty">No entries yet.</td></tr>
                }
            </tbody>
        </table>

        <p class="text-muted mt-3 mb-0" style="font-size:12px;">Inactive entries are hidden from new weighings but stay on old records.</p>
    </div>
</div>