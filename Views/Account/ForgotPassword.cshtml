@model ForgotPasswordViewModel
@{
    ViewData["Title"] = "Reset your password";
    Layout = "_AuthLayout";
    var submitted = ViewData["Submitted"] as bool? ?? false;
}
<h2>Reset your password</h2>
<p class="sub">Enter your username. Your Admin or Super Admin is notified and issues a temporary password.</p>

@if (submitted)
{
    <div class="alert alert-success py-2">
        Reset request sent for <strong>@ViewData["SubmittedUsername"]</strong>. An Admin or Super Admin will issue a temporary password.
    </div>
    <a asp-action="Login" class="btn btn-link ps-0">Back to sign in</a>
}
else
{
    @if (!ViewData.ModelState.IsValid)
    {
        <div class="alert alert-danger py-2">
            @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
            {
                <div>@error.ErrorMessage</div>
            }
        </div>
    }

    <form asp-action="ForgotPassword" method="post" novalidate>
        <div class="mb-3">
            <label asp-for="Username" class="form-label"></label>
            <input asp-for="Username" class="form-control form-control-lg" autofocus />
        </div>
        <button type="submit" class="btn btn-primary btn-lg w-100" style="background:#0ea5e9;border-color:#0ea5e9;">SEND RESET REQUEST</button>
    </form>
    <div class="mt-3">
        <a asp-action="Login">Back to sign in</a>
    </div>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}